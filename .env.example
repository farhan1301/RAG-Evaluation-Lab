LLAMA_CLOUD_API_KEY=""
LLAMA_CLOUD_BASE_URL="https://api.cloud.llamaindex.ai/api"

OPENAI_API_KEY="your-openai-key"
OPENAI_EMBED_MODEL="text-embedding-3-small"
OPENAI_CHAT_MODEL="gpt-4o-mini"

QDRANT_URL="https://your-qdrant-endpoint"
# QDRANT_API_KEY optional if your cluster requires auth
QDRANT_API_KEY=""
QDRANT_COLLECTION="rag-eval-chunks"

PORT=7070

# Frontend should only talk to the backend.
VITE_BACKEND_URL="http://localhost:7070"

# Allow local frontend dev servers by default (comma-separated). Override in production.
CORS_ORIGINS="http://127.0.0.1:3000,http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173"
