# OpenAI — leave chat blank and set to a current model to enable.
OPENAI_API_KEY=""
OPENAI_CHAT_MODEL=""
OPENAI_JUDGE_MODEL=""
# Example: text-embedding-3-small
OPENAI_EMBED_MODEL=""
# OPENAI_EMBED_DIMENSIONS=""
# OPENAI_BASE_URL=""

# Anthropic — examples: claude-sonnet-5-5, claude-opus-5-5, claude-haiku-5-5
ANTHROPIC_API_KEY=""
ANTHROPIC_CHAT_MODEL=""
ANTHROPIC_JUDGE_MODEL=""
# ANTHROPIC_BASE_URL=""

# Optional local OpenAI-compatible embeddings without a cloud account (e.g. Ollama at http://127.0.0.1:11434/v1).
LOCAL_EMBED_BASE_URL=""
LOCAL_EMBED_MODEL=""
# LOCAL_EMBED_API_KEY=""
# LOCAL_EMBED_DIMENSIONS=""

# Optional local OpenAI-compatible chat/judge endpoint.
LOCAL_CHAT_BASE_URL=""
LOCAL_CHAT_MODEL=""
LOCAL_JUDGE_MODEL=""
# LOCAL_CHAT_API_KEY=""
# LOCAL_CHAT_SUPPORTS_TEMPERATURE=true
# LOCAL_CHAT_SUPPORTS_STRUCTURED_OUTPUT=false

# Optional operator-configured HTTP reranker.
RERANK_BASE_URL=""
RERANK_MODEL=""
# RERANK_API_KEY=""

# Optional LlamaParse cloud parser (supports DOCX and scanned PDFs).
LLAMA_CLOUD_API_KEY=""

# Optional Qdrant vector store for dense and hybrid retrieval (keyword FTS5 works without Qdrant).
# Local dev image (see docker-compose.yml): qdrant/qdrant:v1.20.2@sha256:d277592721d2e3b73f9b797b53cf05e6a5bb2134f6d13fdbda4ca51782afbcac
QDRANT_URL=""
QDRANT_API_KEY=""
QDRANT_COLLECTION="rag-eval-chunks"
QDRANT_REQUIRED=false

PORT=7070
# Same-origin by default. Comma-separated additional exact origins and accepted hostnames.
CORS_ORIGINS=""
TRUSTED_HOSTS="localhost,127.0.0.1,[::1]"
# Optional IPs or CIDRs of trusted reverse proxies, comma-separated.
TRUSTED_PROXIES=""
# The API and worker share DATABASE_PATH and BLOB_DIRECTORY.
# BLOB_DIRECTORY defaults to blobs/ beside the SQLite database.
# DOCUMENT_LIMIT_BYTES=12582912
# WORKER_LEASE_MS=30000
# PROVIDER_TIMEOUT_MS=30000
# EMBED_BATCH_SIZE=64
