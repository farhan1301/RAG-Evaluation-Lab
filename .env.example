# =============================================================================
# RAG Evaluation Lab v1.0.0 — Environment Configuration Template
# =============================================================================
# Copy to `.env.local` (native dev) or `.env` (Docker Compose).
# Every variable below has a safe default; leaving all provider settings blank
# boots the app in offline keyword mode (SQLite FTS5 BM25) with zero API keys.
# Never commit real API keys to version control.

# -----------------------------------------------------------------------------
# Server, Origin Checks, and Operational Limits
# -----------------------------------------------------------------------------
# Bind interface for native runs (Docker Compose overrides HOST=0.0.0.0 inside
# the container while publishing loopback 127.0.0.1:${APP_PORT:-7070}:7070).
HOST="127.0.0.1"
PORT=7070
# Optional host loopback port used by compose.yaml (defaults to 7070).
# APP_PORT=7070

# Optional path to built frontend static assets (set to /app/frontend/build in Docker).
# STATIC_DIR=""

# Same-origin browser traffic is allowed by default.
# Comma-separated additional exact origins (e.g. https://eval.internal).
CORS_ORIGINS=""
# Comma-separated accepted Host header hostnames.
TRUSTED_HOSTS="localhost,127.0.0.1,[::1]"
# Optional comma-separated IPv4/IPv6 addresses or CIDRs of trusted reverse proxies.
TRUSTED_PROXIES=""

# Request, upload, rate-limit, and graceful shutdown defaults.
# JSON_LIMIT_BYTES=262144
# DOCUMENT_LIMIT_BYTES=12582912
# RATE_LIMIT=600
# RATE_WINDOW_MS=60000
# SHUTDOWN_TIMEOUT_MS=10000

# -----------------------------------------------------------------------------
# Storage, Worker Queue, and Provider Execution
# -----------------------------------------------------------------------------
# API and worker processes MUST share the same SQLite database and blob folder.
# Docker Compose mounts a named volume at /data and sets both paths automatically.
# DATABASE_PATH="./backend/data/workspace.sqlite"
# BLOB_DIRECTORY=""
# WORKER_LEASE_MS=30000
# PROVIDER_TIMEOUT_MS=30000
# EMBED_BATCH_SIZE=64

# -----------------------------------------------------------------------------
# OpenAI (Optional)
# -----------------------------------------------------------------------------
# Leave chat/judge blank or set to a current model to enable.
OPENAI_API_KEY=""
OPENAI_CHAT_MODEL=""
OPENAI_JUDGE_MODEL=""
# Example embedding model: text-embedding-3-small
OPENAI_EMBED_MODEL=""
# OPENAI_EMBED_DIMENSIONS=""
# OPENAI_BASE_URL=""
# OPENAI_CHAT_SUPPORTS_TEMPERATURE=""

# -----------------------------------------------------------------------------
# Anthropic (Optional)
# -----------------------------------------------------------------------------
# Examples: claude-sonnet-5-5, claude-opus-5-5, claude-haiku-5-5
# Anthropic chat/judge pipelines can pair with OpenAI or local embeddings.
ANTHROPIC_API_KEY=""
ANTHROPIC_CHAT_MODEL=""
ANTHROPIC_JUDGE_MODEL=""
# ANTHROPIC_BASE_URL=""
# ANTHROPIC_CHAT_SUPPORTS_TEMPERATURE=false

# -----------------------------------------------------------------------------
# Local OpenAI-Compatible Embeddings (Optional — Dense/Hybrid Without Cloud)
# -----------------------------------------------------------------------------
# Example (Ollama running locally):
#   Native dev:     LOCAL_EMBED_BASE_URL="http://127.0.0.1:11434/v1"
#   Docker Compose: LOCAL_EMBED_BASE_URL="http://host.docker.internal:11434/v1"
# Set LOCAL_EMBED_MODEL to an embedding model installed in your local server.
LOCAL_EMBED_BASE_URL=""
LOCAL_EMBED_MODEL=""
# LOCAL_EMBED_API_KEY=""
# LOCAL_EMBED_DIMENSIONS=""

# -----------------------------------------------------------------------------
# Local OpenAI-Compatible Chat & Judge (Optional — Full RAG Without Cloud)
# -----------------------------------------------------------------------------
# Example (Ollama running locally):
#   Native dev:     LOCAL_CHAT_BASE_URL="http://127.0.0.1:11434/v1"
#   Docker Compose: LOCAL_CHAT_BASE_URL="http://host.docker.internal:11434/v1"
LOCAL_CHAT_BASE_URL=""
LOCAL_CHAT_MODEL=""
LOCAL_JUDGE_MODEL=""
# LOCAL_CHAT_API_KEY=""
# LOCAL_CHAT_SUPPORTS_TEMPERATURE=true
# LOCAL_CHAT_SUPPORTS_STRUCTURED_OUTPUT=false

# -----------------------------------------------------------------------------
# Optional HTTP Reranker
# -----------------------------------------------------------------------------
# Operator-configured HTTP reranker accepting { model, query, documents, top_n }.
RERANK_BASE_URL=""
RERANK_MODEL=""
# RERANK_API_KEY=""

# -----------------------------------------------------------------------------
# Optional Qdrant Vector Store (Dense & Hybrid Retrieval)
# -----------------------------------------------------------------------------
# Keyword retrieval (SQLite FTS5 BM25) works without Qdrant.
# With Docker Compose, enable Qdrant via: docker compose --profile dense up --build
# Inside Docker set QDRANT_URL="http://qdrant:6333"; natively use "http://127.0.0.1:6333".
QDRANT_URL=""
QDRANT_API_KEY=""
QDRANT_COLLECTION="rag-eval-chunks"
QDRANT_REQUIRED=false

# -----------------------------------------------------------------------------
# Optional Cloud Document Parser (LlamaParse — DOCX & Scanned PDFs)
# -----------------------------------------------------------------------------
# TXT, Markdown, and text-layer PDFs parse locally with zero external calls.
LLAMA_CLOUD_API_KEY=""
# LLAMA_PARSE_API_KEY=""
# LLAMA_CLOUD_BASE_URL="https://api.cloud.llamaindex.ai/api"

# -----------------------------------------------------------------------------
# Optional Operator Price Schedule and Per-Run Budgets
# -----------------------------------------------------------------------------
# Models without an explicit price entry report cost as unknown (never guessed).
# Set either PRICE_SCHEDULE_JSON or PRICE_SCHEDULE_PATH (not both).
# PRICE_SCHEDULE_JSON='{"version":"operator-v1","currency":"USD","entries":[]}'
# PRICE_SCHEDULE_PATH=""
# RUN_MAX_TOKENS=""
# RUN_MAX_COST_USD=""
