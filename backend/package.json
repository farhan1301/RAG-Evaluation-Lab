{
  "name": "rag-eval-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:watch": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').cpSync('src/db/migrations', 'dist/db/migrations', { recursive: true })\"",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@opentelemetry/api": "1.10.0",
    "@rag-eval/contracts": "0.1.0",
    "express": "5.3.0",
    "node-fetch": "^3.3.2",
    "pino": "10.4.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6"
  }
}
