{
  "name": "rag-eval-backend",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:watch": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node -e \"const fs = require('node:fs'); fs.cpSync('src/db/migrations', 'dist/db/migrations', { recursive: true }); fs.cpSync('src/evaluation/rubrics', 'dist/evaluation/rubrics', { recursive: true })\"",
    "start": "node dist/index.js",
    "dev:worker": "tsx src/jobs/worker.ts",
    "start:worker": "node dist/jobs/worker.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.13.0",
    "@opentelemetry/api": "1.10.0",
    "@qdrant/js-client-rest": "1.20.0",
    "@rag-eval/contracts": "1.0.0",
    "express": "5.3.0",
    "openai": "7.63.0",
    "pino": "10.4.0",
    "unpdf": "1.9.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6"
  }
}
